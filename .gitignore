# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
out/
build/
*.tsbuildinfo
.verify/dist-ui/
.verify/dist-export/
.verify/dist-browsers/
# Screenshots the browser harness captures on every run — evidence for the run that produced
# them, not source. Committing them would mean a diff on every verification.
.verify/shots/

# Electron
release/
app/dist/
# ...but apps/desktop/build is electron-builder's buildResources INPUT, not output: it holds the
# app icon. The blanket `build/` rule above would quietly drop the logo from every clone and the
# packaged app would fall back to the default Electron icon with nothing to explain why.
!apps/desktop/build/
!apps/desktop/build/**

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local overrides (machine-specific paths; settings.json is shared, .local isn't)
.claude/settings.local.json

# Env
.env
.env.local

# Open Cut runtime data (local dev)
.opencut-cache/
*.opencut.bak

# Bundled FFmpeg binaries (~110 MB each). Fetched by `npm run ffmpeg:fetch`, verified LGPL by
# `npm run ffmpeg:check`, and shipped by electron-builder's extraResources — but never committed,
# because two binaries of that size are in the history forever. The licence text and the README
# beside them ARE tracked: the LGPL obligation travels with the repo, not just with the download.
apps/desktop/resources/ffmpeg/*
!apps/desktop/resources/ffmpeg/README.md
!apps/desktop/resources/ffmpeg/LICENSE.txt
